    {
      "officeDivision": "San Pedro Jose L. Amante Emergency Hospital",
      "patterns": [
        "Amante",
        "^Medical Record Section$",
        "^Admitting Section$",
        "^OB\\b",
        "^Business Office$",
        "^Administrative Office$",
        "^Philhealth",
        "^Out ?patient Department",
